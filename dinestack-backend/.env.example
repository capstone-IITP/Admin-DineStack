# Backend Environment Variables
# Copy this file to .env and configure all variables securely.

# ==========================================
# 1. Database Configuration
# ==========================================
# PostgreSQL connection string for Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dinestack?schema=public"

# ==========================================
# 2. Cryptography & Encryption (Security Hardening)
# ==========================================
# CRYPTO_KEY: 32 bytes (64 hex characters) used for AES-256-CBC encryption of TOTP secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_KEY=your-32-byte-hex-key-64-characters-long

# CRYPTO_IV: 16 bytes (32 hex characters) used as fallback default IV for legacy TOTP secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRYPTO_IV=your-16-byte-hex-iv-32-characters-long

# ==========================================
# 3. Authentication & Sessions (JWT)
# ==========================================
# Secrets for JWT signatures. Keep these long, random, and confidential.
JWT_SECRET=your-strong-jwt-secret-min-32-chars-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-strong-refresh-token-secret-min-32-chars-long

# ==========================================
# 4. Access Control & Network Policy
# ==========================================
# CORS: Comma-separated list of fully-qualified client origins. Reject dynamic wildcards in production.
ALLOWED_ORIGINS=http://localhost:3000,https://admin.dinestack.in

# IP Whitelisting: Comma-separated list of allowed IPs/CIDRs for super admin panels (if handled by backend).
SUPER_ADMIN_ALLOWED_IPS=127.0.0.1,::1

# ==========================================
# 5. Redis Cache & Rate Limiting
# ==========================================
# Connection URL for Redis used by rate-limit-redis.
# If omitted or unavailable, backend rate limiter falls back to memory storage.
REDIS_URL=redis://localhost:6379

# ==========================================
# 6. Seed Configuration
# ==========================================
# Initial administrator credentials used by database seed scripts.
SUPER_ADMIN_EMAIL=admin@dinestack.in
SUPER_ADMIN_PASSWORD=your-ultra-secure-temporary-password
