generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model SuperAdmin {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  role                 String    @default("MANAGER")
  lastActive           DateTime?
  isActive             Boolean   @default(true)
  failedAttempts       Int       @default(0)
  lockUntil            DateTime?
  lastLogin            DateTime?

  // 2FA fields
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?   // AES-256-CBC encrypted TOTP secret
  twoFactorBackupCodes String[]  // bcrypt-hashed one-time backup codes
  twoFactorEnabledAt   DateTime?
  otpAttempts           Int       @default(0)
  otpBlockedUntil       DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  refreshTokens        RefreshToken[]
}

model SuperAdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  metadata  String?
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String     @id @default(uuid())
  tokenHash String     @unique
  adminId   String
  admin     SuperAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model ActivationCode {
  id           String      @id @default(uuid())
  code         String      @unique
  entityName   String?     // Deprecated: kept for backward compatibility
  plan         String
  durationDays Int
  maxTables    Int
  isUsed       Boolean?    @default(false)
  status       String      @default("ACTIVE") // ACTIVE, INVALIDATED
  expiresAt    DateTime
  usedAt       DateTime?
  restaurantId String?     @unique
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
}

model Restaurant {
  id                   String           @id @default(uuid())
  name                 String           @unique
  ownerEmail           String?
  status               RestaurantStatus @default(ACTIVE)
  isActive             Boolean?         @default(true) // Deprecated, use status
  isRegistered         Boolean?         @default(false) // Legacy field
  forceReactivation    Boolean?         @default(false) // Legacy field
  subscriptionEndsAt   DateTime?
  revokedAt            DateTime?
  revokedBy            String?
  revocationReason     String?
  adminPin             String?
  kitchenPin           String?
  activationCodeId     String?          @unique // Legacy FK - kept for backward compatibility
  activationCode       ActivationCode?
  createdAt            DateTime         @default(now())
  devices              Device[]
  payments             Payment[]
  couponUsages         CouponUsage[]
}

model Device {
  id           String     @id @default(uuid())
  deviceId     String?    @unique  // Legacy device identifier
  type         String     @default("UNKNOWN")
  role         String?    // Legacy role field
  status       String     @default("ACTIVE")
  lastSeen     DateTime   @default(now())
  lastUsed     DateTime?  // Legacy field
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime   @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  user      String
  target    String
  details   String
  severity  String   @default("INFO")
  timestamp DateTime @default(now())
}

model Coupon {
  id              String         @id @default(uuid())
  code            String         @unique
  discountType    String         // PERCENTAGE, FLAT
  discountValue   Float
  status          String         @default("ACTIVE") // ACTIVE, EXPIRED, DISABLED
  expiresAt       DateTime?      // Null for never-expire
  usageCount      Int            @default(0)
  maxUsage        Int?           // Null for unlimited
  createdAt       DateTime       @default(now())
  usages          CouponUsage[]
}

model CouponUsage {
  id            String      @id @default(uuid())
  couponId      String
  coupon        Coupon      @relation(fields: [couponId], references: [id], onDelete: Cascade)
  restaurantId  String
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  usedAt        DateTime    @default(now())
  @@unique([couponId, restaurantId]) // One-time per restaurant usage
}

model Payment {
  id             String     @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String     @default("USD")
  status         String     @default("PENDING") // SUCCESS, PENDING, FAILED, REFUNDED
  transactionId  String     @unique
  invoiceRef     String     @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}
