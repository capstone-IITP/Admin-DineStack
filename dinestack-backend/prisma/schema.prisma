generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SuperAdmin {
  id                   String         @id @default(uuid())
  email                String         @unique
  passwordHash         String
  isActive             Boolean        @default(true)
  failedAttempts       Int            @default(0)
  lockUntil            DateTime?
  lastLogin            DateTime?
  twoFactorEnabled     Boolean        @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]       @default([])
  twoFactorEnabledAt   DateTime?
  otpAttempts          Int            @default(0)
  otpBlockedUntil      DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @default(now()) @updatedAt
  lastActive           DateTime?
  role                 String?
  RefreshToken         RefreshToken[]
}

model RefreshToken {
  id           String      @id @default(uuid())
  tokenHash    String      @unique
  adminId      String?
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  ipAddress    String?
  userAgent    String?
  deviceId     String?
  restaurantId String?
  Restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  admin        SuperAdmin? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([restaurantId])
  @@index([adminId])
}

model ActivationCode {
  id             String      @id @default(uuid())
  code           String      @unique
  entityName     String?
  plan           String?
  durationDays   Int?
  maxTables      Int?
  isUsed         Boolean     @default(false)
  status         String      @default("ACTIVE")
  expiresAt      DateTime?
  usedAt         DateTime?
  restaurantId   String?
  createdAt      DateTime    @default(now())
  
  // New fields for updated Trial logic
  restaurantName String?
  notes          String?
  generatedAt    DateTime    @default(now())
  activatedAt    DateTime?
  generatedBy    String?
  
  Restaurant     Restaurant?

  @@index([restaurantId])
}

model Restaurant {
  id                 String           @id @default(uuid())
  name               String           @unique
  ownerEmail         String?
  status             RestaurantStatus @default(ACTIVE)
  isActive           Boolean?         @default(true)
  isRegistered       Boolean?         @default(false)
  forceReactivation  Boolean?         @default(false)
  subscriptionEndsAt DateTime?
  
  // New fields for updated Trial logic
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  planStatus         String?          @default("TRIAL")
  subscriptionStatus String?          @default("PENDING")

  revokedAt          DateTime?
  revokedBy          String?
  revocationReason   String?
  adminPin           String?
  kitchenPin         String?
  activationCodeId   String?          @unique
  createdAt          DateTime         @default(now())
  address            String?
  city               String?
  email              String?
  phone              String?
  recoveryLockUntil  DateTime?
  clerkUserId        String?          @unique
  updatedAt          DateTime         @default(now())
  ApiKey             ApiKey[]
  Category           Category[]
  Customer           Customer[]
  devices            Device[]
  MenuItem           MenuItem[]
  Order              Order[]
  PairCode           PairCode[]
  RecoveryCode       RecoveryCode[]
  RefreshToken       RefreshToken[]
  ActivationCode     ActivationCode?  @relation(fields: [activationCodeId], references: [id])
  Session            Session[]
  Subscription       Subscription?
  Payment            Payment[]
  Table              Table[]
  TableSession       TableSession[]
}

model Device {
  id           String     @id @default(uuid())
  deviceId     String?    @unique
  type         String     @default("UNKNOWN")
  role         String?
  status       String     @default("ACTIVE")
  lastSeen     DateTime   @default(now())
  lastUsed     DateTime?
  restaurantId String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@index([deviceId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String?
  target    String?
  details   String
  severity  String?
  metadata  String?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
  user      String?

  @@index([timestamp])
}

model Category {
  id           String     @id
  name         String
  isActive     Boolean    @default(true)
  restaurantId String
  createdAt    DateTime   @default(now())
  code         String?
  Restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  MenuItem     MenuItem[]

  @@index([restaurantId])
}

model Customer {
  id           String     @id
  deviceToken  String
  restaurantId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  Order        Order[]

  @@unique([deviceToken, restaurantId])
  @@index([restaurantId])
}

model MenuItem {
  id           String      @id
  name         String
  description  String?
  price        Float
  image        String?
  isActive     Boolean     @default(true)
  categoryId   String
  restaurantId String
  createdAt    DateTime    @default(now())
  Category     Category    @relation(fields: [categoryId], references: [id])
  Restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  OrderItem    OrderItem[]

  @@index([categoryId])
  @@index([restaurantId])
}

model Order {
  id           String      @id
  status       String      @default("RECEIVED")
  totalAmount  Float       @default(0)
  tableId      String
  restaurantId String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  customerId   String?
  Customer     Customer?   @relation(fields: [customerId], references: [id])
  Restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  Table        Table       @relation(fields: [tableId], references: [id])
  OrderItem    OrderItem[]

  @@index([createdAt])
  @@index([customerId])
  @@index([restaurantId])
  @@index([tableId])
}

model OrderItem {
  id         String   @id
  quantity   Int      @default(1)
  notes      String?
  orderId    String
  menuItemId String
  createdAt  DateTime @default(now())
  MenuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  Order      Order    @relation(fields: [orderId], references: [id])

  @@index([menuItemId])
  @@index([orderId])
}

model PairCode {
  id             String     @id
  code           String     @unique
  restaurantId   String
  pairCodeActive Boolean    @default(true)
  pairCodeUsed   Boolean    @default(false)
  kitchenOnline  Boolean    @default(false)
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime   @default(now())
  expiresAt      DateTime
  Restaurant     Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

model RecoveryCode {
  id           String     @id
  codeHash     String
  used         Boolean    @default(false)
  restaurantId String
  createdAt    DateTime   @default(now())
  Restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

model Session {
  id           String     @id
  token        String     @unique
  tableId      String
  restaurantId String
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  Restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  Table        Table      @relation(fields: [tableId], references: [id])

  @@index([restaurantId])
  @@index([tableId])
}

model Table {
  id           String         @id
  label        String
  capacity     Int            @default(4)
  isActive     Boolean        @default(true)
  restaurantId String
  createdAt    DateTime       @default(now())
  Order        Order[]
  Session      Session[]
  Restaurant   Restaurant     @relation(fields: [restaurantId], references: [id])
  TableSession TableSession[]

  @@index([restaurantId])
}

model TableSession {
  id           String     @id
  tableId      String
  restaurantId String
  status       String     @default("ACTIVE")
  isActive     Boolean    @default(true)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  Table        Table      @relation(fields: [tableId], references: [id])

  @@index([restaurantId])
  @@index([tableId])
}

model ApiKey {
  id           String     @id
  key          String     @unique
  name         String     @default("Default Key")
  restaurantId String
  createdAt    DateTime   @default(now())
  lastUsedAt   DateTime?
  Restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

model Subscription {
  id                     String     @id
  restaurantId           String     @unique
  razorpayCustomerId     String?    @unique
  razorpaySubscriptionId String?    @unique
  planId                 String
  status                 String     @default("TRIAL")
  autopayEnabled         Boolean    @default(false)
  trialStartDate         DateTime?
  trialEndDate           DateTime?
  currentCycleStart      DateTime?
  currentCycleEnd        DateTime?
  nextBillingDate        DateTime?
  paymentFailureCount    Int        @default(0)
  gracePeriodEndDate     DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime
  Restaurant             Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

model SuperAdminAuditLog {
  id        String   @id
  adminId   String
  action    String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([adminId])
}

model WebhookEvent {
  id        String   @id
  eventId   String   @unique
  eventType String
  payload   String
  createdAt DateTime @default(now())
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model Payment {
  id            String     @id @default(uuid())
  status        String
  transactionId String?
  invoiceRef    String?
  amount        Float
  currency      String     @default("USD")
  restaurantId  String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String
  discountValue Float
  expiresAt     DateTime?
  maxUsage      Int?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
}

