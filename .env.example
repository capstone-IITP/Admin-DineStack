# Frontend Environment Variables
# Copy this file to .env.local and populate the values.

# ==========================================
# 1. API Integration
# ==========================================
# The fully-qualified URL where the DineStack Backend is running.
# In development, it defaults to http://localhost:5000 if not specified.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ==========================================
# 2. Database Seeding & Setup
# ==========================================
# Administrator credentials for initializing the database (used by init-db.js / seeds).
SUPER_ADMIN_EMAIL=admin@dinestack.in
SUPER_ADMIN_PASSWORD=your-ultra-secure-temporary-password

# ==========================================
# 3. Edge Network Access Control
# ==========================================
# Comma-separated list of IPv4/IPv6 addresses allowed to pass the Edge Admin Panel gateway.
# Example: 192.168.1.100,203.0.113.50
SUPER_ADMIN_ALLOWED_IPS=127.0.0.1,::1
